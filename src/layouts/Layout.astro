---
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description?: string;
	lang?: string;
	bodyClass?: string;
	canonicalPath?: string;
	ogType?: 'website' | 'article';
	ogImage?: string;
}

const {
	title,
	description = "kyoh86's personal website",
	lang = 'ja',
	bodyClass,
	canonicalPath = Astro.url.pathname,
	ogType = 'website',
	ogImage = '/og/default.png',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://kyoh86.dev');
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const googleTagId = import.meta.env.PUBLIC_GOOGLE_TAG_ID ?? 'G-4RS020GXGP';

if (googleTagId && !/^[A-Z]+-[A-Z0-9]+$/i.test(googleTagId)) {
	throw new Error('PUBLIC_GOOGLE_TAG_ID must look like G-XXXXXXXXXX');
}
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{
			googleTagId && (
				<>
					<script async src={`https://www.googletagmanager.com/gtag/js?id=${googleTagId}`} />
					<script is:inline define:vars={{ googleTagId }}>
						window.dataLayer = window.dataLayer || [];
						function gtag() {
							dataLayer.push(arguments);
						}
						gtag('js', new Date());
						gtag('config', googleTagId);
					</script>
				</>
			)
		}
		<link rel="icon" type="image/png" href="/icn_panda_01_520.png" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" type="application/rss+xml" title="kyoh86 Posts" href={new URL('/rss.xml', siteUrl).toString()} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:site_name" content="kyoh86" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<Font cssVariable="--font-symbols" />
		<title>{title}</title>
	</head>
	<body class={bodyClass}>
		<slot />
	</body>
</html>
