---
import { getAmazonProduct } from '../lib/amazon-products';

interface Props {
	asin: string;
	title?: string;
	imageSrc?: string;
	imageAlt?: string;
	imageLayout?: 'thumb' | 'large';
}

const asin = Astro.props.asin.trim();
const product = getAmazonProduct(asin);
const href = product?.detailPageURL ?? `https://link.amazon/${asin}`;
const title = Astro.props.title || product?.title || `Amazon商品 ${asin}`;
const imageSrc = Astro.props.imageSrc ?? product?.image?.url;
const imageAlt = Astro.props.imageAlt ?? '';
const imageLayout = Astro.props.imageLayout ?? 'thumb';
const imageWidth = Astro.props.imageSrc ? undefined : product?.image?.width;
const imageHeight = Astro.props.imageSrc ? undefined : product?.image?.height;
---

<a
	class:list={['amazon-link', `amazon-link--${imageLayout}`]}
	href={href}
	target="_blank"
	rel="sponsored noopener noreferrer"
	data-amazon-link
	data-amazon-asin={asin}
	data-amazon-title={title}
	data-amazon-layout={imageLayout}
>
	{
		imageSrc ? (
			<img
				class="amazon-link__image"
				src={imageSrc}
				alt={imageAlt}
				width={imageWidth}
				height={imageHeight}
				loading="lazy"
				decoding="async"
			/>
		) : (
			<span class="amazon-link__source">Amazon</span>
		)
	}
	<span class="amazon-link__body">
		<strong>{title}</strong>
		<span class="amazon-link__cta">Amazonで見る</span>
	</span>
</a>

<script>
	document.addEventListener('click', (event) => {
		const link = event.target instanceof Element
			? event.target.closest<HTMLAnchorElement>('a[data-amazon-link]')
			: null;

		if (!link || typeof window.gtag !== 'function') return;

		window.gtag('event', 'amazon_link_click', {
			asin: link.dataset.amazonAsin,
			item_name: link.dataset.amazonTitle,
			link_url: link.href,
			image_layout: link.dataset.amazonLayout,
		});
	});
</script>

<style>
	.amazon-link {
		display: grid;
		grid-template-columns: minmax(6rem, auto) minmax(0, 1fr);
		gap: 1rem;
		align-items: center;
		margin: 1.5rem 0;
		padding: 1rem;
		color: inherit;
		text-decoration: none;
		border: 1px solid #d1d5db;
		border-radius: 0.5rem;
	}

	.amazon-link--large {
		grid-template-columns: 1fr;
		align-items: stretch;
	}

	.amazon-link:hover {
		border-color: #f59e0b;
	}

	.amazon-link__image {
		width: 6rem;
		aspect-ratio: 1;
		object-fit: contain;
		background: #ffffff;
		border: 1px solid #e5e7eb;
		border-radius: 0.375rem;
	}

	.amazon-link__source {
		display: inline-grid;
		place-items: center;
		min-width: 6rem;
		min-height: 6rem;
		padding: 0 1rem;
		color: #111827;
		font-size: 0.875rem;
		font-weight: 700;
		background: #fbbf24;
		border-radius: 0.375rem;
	}

	.amazon-link--large .amazon-link__image {
		width: 100%;
		max-height: 22rem;
	}

	.amazon-link--large .amazon-link__source {
		width: 100%;
		min-height: 8rem;
	}

	.amazon-link__body {
		display: grid;
		gap: 0.25rem;
		min-width: 0;
	}

	.amazon-link__body strong {
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.amazon-link__body > span {
		color: #4b5563;
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	.amazon-link__body .amazon-link__cta {
		color: #b45309;
		font-size: 0.875rem;
		font-weight: 700;
	}

	@media (max-width: 32rem) {
		.amazon-link {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.amazon-link__image,
		.amazon-link__source {
			width: 100%;
			min-width: 0;
			min-height: 3rem;
		}

		.amazon-link__image {
			height: auto;
			max-height: 8rem;
		}

		.amazon-link--large .amazon-link__image {
			max-height: none;
		}
	}
</style>
