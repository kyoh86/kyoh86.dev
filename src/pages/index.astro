---
import Layout from '../layouts/Layout.astro';
---

<Layout title="kyoh86" description="kyoh86's personal website" bodyClass="home-page">
	<main>
		<div class="container">
			<header>
				<h1>kyoh86</h1>
				<p class="tagline">Software Developer</p>
			</header>

			<section class="bio">
				<p>Passionate about building elegant solutions with clean code.</p>
			</section>

			<section class="links">
				<a href="https://github.com/kyoh86" target="_blank" rel="noopener noreferrer" class="github-link">
					<svg class="icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
					</svg>
					GitHub
				</a>
			</section>

			<section class="projects">
				<h2>Projects</h2>
				<div class="project-list">
					<a href="https://speech-jammer.kyoh86.dev" target="_blank" rel="noopener noreferrer" class="project-link">
						<span class="project-icon" aria-hidden="true">🎤</span>
						<div class="project-info">
							<h3>スピーチジャマー・チャレンジ</h3>
							<p>聴覚遅延フィードバックで話すのが困難になる現象を体験できるゲーム</p>
						</div>
					</a>
					<a href="https://mikke.kyoh86.dev" target="_blank" rel="noopener noreferrer" class="project-link">
						<span class="project-icon" aria-hidden="true">🔭</span>
						<div class="project-info">
							<h3>みっけさんぽ</h3>
							<p>街中で見かけた変なものを記録する遊び</p>
						</div>
					</a>
				</div>
			</section>

			<section class="notes">
				<h2>Notes</h2>
				<div class="note-list">
					<a href="/pane-layout/" class="note-link">
						<span class="note-icon" aria-hidden="true">🪟</span>
						<div class="note-info">
							<h3>Neovim/tmuxのペイン配置について</h3>
							<p>ペインとかウインドウの操作むずすぎて嫌なので色々考えたメモ</p>
						</div>
					</a>
				</div>
			</section>
		</div>
	</main>
</Layout>

<style>
	:global(body) {
		margin: 0;
		font-family: system-ui, sans-serif;
		color: #1f2937;
		background: #ffffff;
	}

	main {
		display: grid;
		min-height: 100vh;
		place-items: center;
		padding: 2rem;
	}

	.container {
		max-width: 600px;
		text-align: center;
	}

	header,
	.bio {
		margin-bottom: 2rem;
	}

	h1 {
		margin: 0;
		font-size: 3rem;
		line-height: 1;
	}

	h2 {
		margin-top: 3rem;
	}

	.tagline,
	.bio p,
	.project-info p,
	.note-info p {
		color: #4b5563;
	}

	.links,
	.project-list,
	.note-list {
		display: grid;
		gap: 1rem;
	}

	.github-link,
	.project-link,
	.note-link {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem;
		color: inherit;
		text-align: left;
		text-decoration: none;
		border: 1px solid #d1d5db;
		border-radius: 0.5rem;
	}

	.github-link {
		justify-self: center;
	}

	.icon {
		width: 20px;
		height: 20px;
		fill: currentColor;
	}

	.project-icon,
	.note-icon {
		font-size: 1.5rem;
	}

	.project-info h3,
	.note-info h3 {
		margin: 0 0 0.25rem;
	}

	.project-info p,
	.note-info p {
		margin: 0;
	}
</style>
