---
import Layout from '../layouts/Layout.astro';
---

<Layout title="kyoh86" description="kyoh86's personal website" bodyClass="home-page">
  <main>
    <div class="container">
      <header>
        <h1>kyoh86</h1>
        <p class="tagline">Software Developer</p>
      </header>

      <section class="bio">
        <p>Passionate about building elegant solutions with clean code.</p>
      </section>

      <section class="link-container">
        <section class="link-category">
          <h2>Socials</h2>
          <div class="link-list">
            <a href="https://github.com/kyoh86" target="_blank" rel="noopener noreferrer" class="link">
              <span class="icon" aria-hidden="true">code</span>
              <div class="link-info">
                <h3>GitHub</h3>
                <p>&#64;kyoh86</p>
              </div>
            </a>
            <a href="https://x.com/kyoh86" target="_blank" rel="noopener noreferrer" class="link">
              <span class="icon" aria-hidden="true">raven</span>
              <div class="link-info">
                <h3>X(Twitter)</h3>
                <p>&#64;kyoh86 - 特に気遣うことなくなんとなく</p>
              </div>
            </a>
            <a href="https://x.com/kyoh86anim" target="_blank" rel="noopener noreferrer" class="link">
              <span class="icon" aria-hidden="true">pets</span>
              <div class="link-info">
                <h3>X(Twitter)</h3>
                <p>&#64;kyoh86anim - ペット・虫関係用</p>
              </div>
            </a>
          </div>
        </section>

        <section class="link-category">
          <h2>Projects</h2>
          <div class="link-list">
            <a href="https://speech-jammer.kyoh86.dev" target="_blank" rel="noopener noreferrer" class="link">
              <span class="icon" aria-hidden="true">mic</span>
              <div class="link-info">
                <h3>スピーチジャマー・チャレンジ</h3>
                <p>聴覚遅延フィードバックで話すのが困難になる現象を体験できるゲーム</p>
              </div>
            </a>
            <a href="https://mikke.kyoh86.dev" target="_blank" rel="noopener noreferrer" class="link">
              <span class="icon" aria-hidden="true">travel_explore</span>
              <div class="link-info">
                <h3>みっけさんぽ</h3>
                <p>街中で見かけた変なものを記録する遊び</p>
              </div>
            </a>
          </div>
        </section>

        <section class="link-category">
          <h2>Notes</h2>
          <div class="link-list">
            <a href="/pane-layout/" class="link">
              <span class="icon" aria-hidden="true">splitscreen</span>
              <div class="link-info">
                <h3>Neovim/tmuxのペイン配置について</h3>
                <p>ペインとかウインドウの操作むずすぎて嫌なので色々考えたメモ</p>
              </div>
            </a>
          </div>
        </section>
      </section>
    </div>
  </main>
</Layout>

<style>
  :global(body) {
    margin: 0;
    font-family: system-ui, sans-serif;
    color: #1f2937;
    background: #ffffff;
  }

  main {
    display: grid;
    min-height: 100vh;
    padding: 2rem;
  }

  .container {
    text-align: center;
  }

  header,
  .bio {
    margin-bottom: 2rem;
  }

  h1 {
    margin: 0;
    font-size: 3rem;
    line-height: 1;
  }

  h2 {
    margin-top: 3rem;
  }

  .tagline,
  .bio p,
  .social p,
  .link-info p {
    color: #4b5563;
  }

  .link-container {
    display: flex;
    flex-flow: row wrap;
  }

  .link-category {
    flex: 1 1 0;
    margin: 0 1rem;
    min-width: 32rem;
  }

  .link-list {
    display: grid;
    gap: 1rem;
  }

  .link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    color: inherit;
    text-align: left;
    text-decoration: none;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
  }

  .icon {
    flex: 0 0 auto;
    width: 1.5rem;
    font-family: var(--font-symbols);
    font-size: 1.5rem;
    font-style: normal;
    font-weight: normal;
    line-height: 1;
    text-align: center;
    text-transform: none;
    letter-spacing: normal;
    white-space: nowrap;
    font-variation-settings:
      'FILL' 0,
      'wght' 400,
      'GRAD' 0,
      'opsz' 24;
  }

  .link-info h3 {
    margin: 0 0 0.25rem;
  }

  .link-info p {
    margin: 0;
  }
</style>
