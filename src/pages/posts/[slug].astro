---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import DraftBadge from '../../components/DraftBadge.astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			newerPost: posts[index - 1],
			olderPost: posts[index + 1],
		},
	}));
}

const { post, newerPost, olderPost } = Astro.props;
const { Content } = await render(post);
const cover = post.data.cover;
const hasAffiliateLink =
	/<AmazonLink\b/.test(post.body) ||
	/\b(?:link\.amazon|amzn\.to|(?:www\.)?amazon\.co\.jp)\b/.test(post.body);

if (cover && (cover.width !== 1200 || cover.height !== 630)) {
	throw new Error(
		`${post.id}: cover must be exactly 1200x630, got ${cover.width}x${cover.height}`,
	);
}

const ogImage = `/og/posts/${post.id}.png`;

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('ja-JP', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	}).format(date);
---

<ArticleLayout
	title={`${post.data.title} - kyoh86`}
	description={post.data.description}
	canonicalPath={`/posts/${post.id}/`}
	ogImage={ogImage}
>
	<header>
		<a href="/posts/" class="back-link">Posts</a>
		<h1>{post.data.title}{post.data.draft && <DraftBadge />}</h1>
		<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
	</header>
	{
		hasAffiliateLink && (
			<p class="affiliate-note">このサイトはアフィリエイトを利用しています。</p>
		)
	}
	{cover && <Image src={cover} alt="" aria-hidden="true" class="cover" />}
	<Content />
	<nav slot="after-article" class="post-nav" aria-label="Post navigation">
		{
			olderPost ? (
				<a href={`/posts/${olderPost.id}/`} class="post-nav-link">
					<span>前の記事</span>
					<strong>{olderPost.data.title}</strong>
				</a>
			) : (
				<span class="post-nav-placeholder" aria-hidden="true" />
			)
		}
		{
			newerPost ? (
				<a href={`/posts/${newerPost.id}/`} class="post-nav-link next">
					<span>次の記事</span>
					<strong>{newerPost.data.title}</strong>
				</a>
			) : (
				<span class="post-nav-placeholder" aria-hidden="true" />
			)
		}
	</nav>
</ArticleLayout>

<style>
	.post-nav {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid #d1d5db;
	}

	.post-nav-link {
		display: grid;
		gap: 0.25rem;
		color: inherit;
		text-decoration: none;
	}

	.post-nav-link.next {
		text-align: right;
	}

	.post-nav-link span {
		color: #4b5563;
		font-size: 0.875rem;
	}

	.post-nav-link strong {
		font-size: 1rem;
		line-height: 1.4;
	}

	@media (max-width: 40rem) {
		.post-nav {
			grid-template-columns: 1fr;
		}

		.post-nav-link.next {
			text-align: left;
		}

		.post-nav-placeholder {
			display: none;
		}
	}
</style>
